# Example Caddyfile block for the hosted HTTP mode. Add it to your Caddyfile and `caddy reload`.
#
# Upstream: docker-compose.yml publishes the container on 127.0.0.1:8080, so a Caddy running on
# the same host reaches it there. If your Caddy runs in a container on a shared Docker network
# instead, attach toggl-mcp to that network and use `toggl-mcp:8080` as the upstream.
#
# Prereqs:
#   - DNS: toggl-mcp.example.com points at your server.
#   - The MCP resource URL is https://toggl-mcp.example.com/mcp - it MUST byte-match
#     AUTH__RESOURCEURL and the PRM `resource`.

toggl-mcp.example.com {
	encode zstd gzip

	# HSTS: once seen over HTTPS, browsers/agents refuse plaintext for a year.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Only the intended routes reach the container; everything else is refused rather than
	# blindly forwarded. Streamable HTTP uses SSE, so disable proxy buffering on /mcp.
	# (`handle` takes at most ONE inline matcher token — multi-path routes need named matchers.)
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
	# OAuth Protected Resource Metadata + health probe + the (auth-gated) settings page.
	@meta path /.well-known/* /healthz /settings
	handle @meta {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond 404
	}

	# Optional hardening: restrict /mcp to your MCP client's egress range (for Claude's hosted
	# connectors, see Anthropic's published IP ranges). Leave commented until verified: a wrong
	# CIDR locks the client out.
	# @notanthropic not remote_ip <client-cidr>
	# respond @notanthropic 403
}
