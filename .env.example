# ── toggl-mcp environment ────────────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in. Double underscore = config nesting.
# Values here override appsettings.json.

# ── Toggl (Phase 1: single account) ──────────────────────────────────────────
# Raw Toggl Track account token (Profile → API Token). NOT a toggl_sk_ key.
# Used as the Basic-auth USERNAME with the literal password "api_token".
TOGGL__APITOKEN=

# Optional: pin the workspace. If empty it's discovered from /me (default_workspace_id).
# TOGGL__WORKSPACEID=1234567

# ── Auth (Authentik OAuth resource server) ───────────────────────────────────
# Secure by default: any non-local (non-Development) deployment MUST run with auth on — the app
# refuses to start with auth off outside the Development environment. For local dev use `dotnet run`
# (its Development env auto-disables auth); do NOT set AUTH__ENABLED=false for a real deployment.
AUTH__ENABLED=true
# OIDC issuer of the Authentik provider, e.g. https://auth.irminsul.uk/application/o/toggl-mcp/
AUTH__AUTHORITY=
# Public MCP URL — must byte-match the JWT `aud` and the PRM `resource`, e.g. https://toggl.irminsul.uk/mcp
AUTH__RESOURCEURL=

# ── Storage ───────────────────────────────────────────────────────────────────
# Durable dir for mapping rules (+ Phase 3 token vault & Data Protection key ring).
# In Docker this is a mounted volume — losing it makes stored tokens undecryptable.
STORAGE__DATADIR=/data

# ── Kestrel ─────────────────────────────────────────────────────────────────
ASPNETCORE_URLS=http://+:8080
