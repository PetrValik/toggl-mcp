# ── toggl-mcp environment ────────────────────────────────────────────────────
# Copy to `.env` (gitignored) and fill in. Double underscore = config nesting.
# Values here override appsettings.json.

# ── Toggl (single account) ───────────────────────────────────────────────────
# Raw Toggl Track account token (Profile → API Token). NOT a toggl_sk_ key.
# Used as the Basic-auth USERNAME with the literal password "api_token".
TOGGL__APITOKEN=

# Optional: pin the workspace. If empty it's discovered from /me (default_workspace_id).
# TOGGL__WORKSPACEID=1234567

# ── Auth: HTTP mode only (any OIDC provider; tested with Authentik) ──────────
# Secure by default: any non-local (non-Development) deployment MUST run with auth on — the app
# refuses to start with auth off outside the Development environment. For local dev use `dotnet run`
# (its Development env auto-disables auth); do NOT set AUTH__ENABLED=false for a real deployment.
AUTH__ENABLED=true
# OIDC issuer, e.g. https://auth.example.com/application/o/toggl-mcp/ (Authentik style)
AUTH__AUTHORITY=
# Public MCP URL — must byte-match the JWT `aud` and the PRM `resource`, e.g. https://toggl-mcp.example.com/mcp
AUTH__RESOURCEURL=

# ── Storage ───────────────────────────────────────────────────────────────────
# Durable dir for mapping rules and the commit ledger. Default is 'data'. In stdio mode a relative
# value resolves under your local app-data folder; in HTTP mode, relative to the working directory.
# In Docker this is a mounted volume; losing it makes the server forget what it already wrote.
STORAGE__DATADIR=/data

# ── Week boundaries and the optional lock ────────────────────────────────────
# IANA time zone for day/week boundaries. Blank = the machine's own zone. Set it in containers (UTC).
# LOCK__TIMEZONE=Europe/Prague
# Opt-in permanent weekly lock, for workspaces whose admin locks weeks. Default false.
# LOCK__ENABLED=false
# LOCK__CLOSEDAYOFWEEK=Friday
# LOCK__CLOSETIME=23:59:00
# LOCK__GRACEWEEKS=1          # a week locks on the close day of the following week
# LOCK__ADMINCONTACT=your workspace admin   # named in refusal messages

# ── Kestrel ─────────────────────────────────────────────────────────────────
ASPNETCORE_URLS=http://+:8080
